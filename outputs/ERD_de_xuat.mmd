%% ERD đề xuất cho web — bản thiết kế mục tiêu, không phải schema đang chạy.
erDiagram
  WORKER {
    string id PK
    string idCard UK
    string code "Mã hồ sơ"
    string fullName
    string phone
  }
  WORK_ASSIGNMENT {
    string id PK
    string workerId FK
    string interviewFactoryId FK
    string workingFactoryId FK "Nullable"
    string statusId FK
    string employeeCode "Mã NV theo công ty/đợt"
    string recruiterId FK "Nullable"
    string teamId FK "Snapshot team phụ trách"
    string orderId FK "Nullable"
    string batchId FK "Nullable, cùng orderId"
    string interviewDate
    string shuttleBusKtx
    string expectedTrainingStatus
  }
  FACTORY {
    string id PK
    string code UK
    string name UK
    boolean isActive
  }
  LABOR_STATUS {
    string id PK
    string name UK
    string category
    boolean isActive
  }
  RECRUITMENT_ORDER {
    string id PK
    string code UK
    string name
    string factoryId FK
    boolean isActive
  }
  RECRUITMENT_BATCH {
    string id PK
    string orderId FK
    string code
    string name
    string startDate
    string endDate
    string compositeKey "UK (id, orderId)"
  }
  RECRUITMENT_TEAM {
    string id PK
    string code UK
    string name
    boolean isActive
  }
  RECRUITER {
    string id PK
    string code UK
    string name
    string teamId FK "Nullable, home team"
    boolean isActive
  }
  BANK_ACCOUNT {
    string id PK
    string workerId FK
    string bankName
    string accountNumber
    string accountHolderName
  }
  BONUS_RECORD {
    string id PK
    string workerId FK
    string assignmentId FK "Nullable"
    string month
    string companySnapshot
    string policySnapshot
    string workerCodeSnapshot
    float bonus1
    float bonus2
    float bonus3
    float bonus4
    float bonus5
    float bonus6
    float bonus7
    float totalBonus
    string accountNumberSnapshot
    string bankNameSnapshot
    string status
  }
  BONUS_POLICY {
    string id PK
    string name
    string factoryId FK "Nullable"
    string orderId FK "Nullable"
    string rulesJson
    boolean isActive
  }
  POLICY_ENROLLMENT {
    string id PK
    string assignmentId FK
    string policyId FK
    string policyNameSnapshot
    string rulesSnapshot
    string effectiveFrom
    string effectiveTo
  }
  REWARD_STAGE {
    string id PK
    string enrollmentId FK
    int step
    string label
    float thresholdDays
    int amount
    boolean eligible
    boolean achieved
  }
  REWARD_PAYMENT {
    string id PK
    string stageId FK
    int amount
    string paidOn
    string reference UK
  }
  ASSIGNMENT_EVENT {
    string id PK
    string assignmentId FK
    string occurredOn
    string fromStatusSnapshot
    string toStatusSnapshot
  }
  AUDIT_LOG {
    string id PK
    string module
    string action
    string operator
    datetime createdAt
  }
  IMPORT_PROFILE {
    string id PK
    string name UK
    string sheetName
    string mappingJson
    string syncDirection
  }

  WORKER ||--o{ WORK_ASSIGNMENT : has
  WORKER ||--o{ BANK_ACCOUNT : owns
  WORKER ||--o{ BONUS_RECORD : receives
  WORK_ASSIGNMENT o|--o{ BONUS_RECORD : links_optional
  FACTORY ||--o{ RECRUITMENT_ORDER : serves
  FACTORY ||--o{ WORK_ASSIGNMENT : interview_factory
  FACTORY o|--o{ WORK_ASSIGNMENT : working_factory
  RECRUITMENT_ORDER ||--o{ RECRUITMENT_BATCH : contains
  RECRUITMENT_ORDER o|--o{ WORK_ASSIGNMENT : assigned_to
  RECRUITMENT_BATCH o|--o{ WORK_ASSIGNMENT : assigned_to_same_order
  RECRUITMENT_TEAM o|--o{ RECRUITER : home_team
  RECRUITER o|--o{ WORK_ASSIGNMENT : assigned_recruiter
  RECRUITMENT_TEAM o|--o{ WORK_ASSIGNMENT : team_snapshot
  LABOR_STATUS ||--o{ WORK_ASSIGNMENT : current_status
  RECRUITMENT_ORDER o|--o{ BONUS_POLICY : scopes
  FACTORY o|--o{ BONUS_POLICY : scopes
  WORK_ASSIGNMENT ||--o{ ASSIGNMENT_EVENT : logs
  WORK_ASSIGNMENT ||--o{ POLICY_ENROLLMENT : enrolls
  BONUS_POLICY ||--o{ POLICY_ENROLLMENT : applies
  POLICY_ENROLLMENT ||--o{ REWARD_STAGE : defines
  REWARD_STAGE ||--o{ REWARD_PAYMENT : pays
